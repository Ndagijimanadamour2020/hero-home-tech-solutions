generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  password         String
  email            String?
  resetToken       String?
  resetTokenExpiry DateTime?
}

model SiteConfig {
  id      String @id @default(cuid())
  logoUrl String
}