// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  DEMO_SCHEDULED
  PROPOSAL_SENT
  WON
  LOST
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum PriceType {
  FIXED
  STARTING_FROM
  CONTACT
  CONTACT_FOR_PRICE
  FREE_DEMO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  INVALID
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SectionType {
  SERVICES
  SOLUTIONS
  PORTFOLIO
  ABOUT
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  password         String
  passwordHash     String?
  email            String?
  role             Role      @default(ADMIN)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SiteConfig {
  id      String @id @default(cuid())
  logoUrl String
}

model SectionContent {
  id          String      @id @default(cuid())
  type        SectionType @unique
  title       String
  subtitle    String?
  description String      @db.Text
  content     Json?
  published   Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())
}

model Solution {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  tagline        String
  problem        String      @db.Text
  solution       String      @db.Text
  features       String[]
  benefits       String[]
  targetAudience String
  icon           String?
  published      Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  demos          Demo[]
  caseStudies    CaseStudy[]
}

model Industry {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  icon        String?
  useCases    String[]
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Demo {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  screenshot  String?
  demoUrl     String?
  features    String[]
  solutionId  String?
  solution    Solution? @relation(fields: [solutionId], references: [id], onDelete: SetNull)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model CaseStudy {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  clientName     String
  challenge      String    @db.Text
  solution       String    @db.Text
  features       String[]
  technologies   String[]
  impact         String[]
  solutionId     String?
  solutionRecord Solution? @relation(fields: [solutionId], references: [id], onDelete: SetNull)
  published      Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id               String        @id @default(cuid())
  projectName      String        // Renamed/added for admin direct name reference
  title            String
  slug             String        @unique
  projectProblem   String        @db.Text
  projectSolution  String        @db.Text
  projectBenefits  String        @db.Text
  problem          String?       @db.Text
  solution         String?       @db.Text
  benefits         String?       @db.Text
  shortDescription String?       @db.Text
  description      String?       @db.Text
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client           String?
  technologies     String[]
  features         String[]
  price            Float         @default(0)
  currency         String        @default("USD")
  priceType        PriceType     @default(FIXED)
  image            String?
  images           String[]      // At least 5 image URLs for the visitor 3D rotating showcase
  downloadFolder   String?       // Deprecated / optional alternative
  projectZipUrl    String?       // Direct download URL for the client project .zip file
  liveDemoUrl      String?
  sourceCodeUrl    String?
  projectUrl       String?
  status           ProjectStatus @default(DRAFT)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0)
  isPurchasable    Boolean       @default(true)
  paymentCta       String        @default("Buy Now")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  leads            Lead[]
  orders           Order[]

  @@index([status, featured, displayOrder])
  @@index([categoryId])
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  business  String?
  email     String
  phone     String
  industry  String?
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  budget    String?
  type      String?    @default("INQUIRY")
  message   String?    @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
}

model Order {
  id                       String        @id @default(cuid())
  orderNumber              String        @unique
  projectId                String
  project                  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  customerName             String
  customerEmail            String
  customerPhone            String
  customerBusiness         String?
  amount                   Float
  currency                 String        @default("USD")
  pesapalMerchantReference String        @unique
  pesapalTrackingId        String?
  paymentMethod            String?
  paymentStatus            PaymentStatus @default(PENDING)
  orderStatus              OrderStatus   @default(PENDING_PAYMENT)
  paymentUrl               String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  paidAt                   DateTime?

  @@index([projectId, paymentStatus])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String
  page      String
  meta      Json?
  createdAt DateTime @default(now())
}